NODE_ENV=production

CONTROL_API_PUBLIC_PORT=4001
GATEWAY_PUBLIC_PORT=4002
WEB_ADMIN_PUBLIC_PORT=3001

CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=4001
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=4002
WEB_ADMIN_PORT=3001
EXPORT_WORKER_HEALTH_HOST=0.0.0.0
EXPORT_WORKER_HEALTH_PORT=4010

DEMO_MODE=0

DATABASE_URL=postgres://teamops:<replace-postgres-password>@postgres:5432/teamops
VALKEY_URL=redis://valkey:6379
POSTGRES_PASSWORD=<replace-postgres-password>

CONTROL_API_ADMIN_TOKEN=<replace-control-api-admin-token>
ENCRYPTION_KEY_BASE64=<replace-encryption-key-base64>
FINGERPRINT_KEY_ENCRYPTION_KEY_BASE64=<replace-fingerprint-key-base64>
PRIVATE_RESPONSE_ATTESTATION_SECRET=<replace-attestation-secret>
PRIVATE_RESPONSE_ATTESTATION_KEY_ID=<replace-attestation-key-id>
# Optional per-service override.
# PRIVATE_RESPONSE_ATTESTATION_INSTANCE_ID=preview-runtime-1

# Use a public https origin for OIDC callbacks.
# A stable domain is preferred, but temporary https tunnel domains can be used for validation.
WEB_ADMIN_BASE_URL=https://admin.example.com
# Used by host-mode production starts. Preview compose overrides this to `http://control-api:4001`.
CONTROL_API_BASE_URL=http://127.0.0.1:4001
NEXT_PUBLIC_CONTROL_API_BASE_URL=https://api.example.com
GATEWAY_PUBLIC_BASE_URL=https://gateway.example.com
WEB_ADMIN_AUTH_MODE=bootstrap_admin
