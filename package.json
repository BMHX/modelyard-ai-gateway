{
  "name": "claude-code-team-ops",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "ai-gateway",
    "llm-gateway",
    "llmops",
    "ai-governance",
    "byok",
    "virtual-keys",
    "model-routing",
    "api-key-management",
    "ai-cost-management",
    "openai-compatible",
    "self-hosted",
    "typescript",
    "nextjs",
    "fastify",
    "postgresql",
    "docker"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:stack",
    "lint": "node ./tools/repo-lint.mjs",
    "start": "npm run start:prod:admin",
    "build": "npm run build:config && npm run build:contracts && npm run build:database && npm run build:export-jobs && npm run build:control-api && npm run build:export-worker && npm run build:gateway && npm run build:web-admin",
    "dev:web-admin": "npm run dev -w @teamops/web-admin",
    "dev:desktop": "npm run dev -w @teamops/desktop",
    "dev:control-api": "npm run dev -w @teamops/control-api",
    "dev:export-worker": "npm run dev -w @teamops/export-worker",
    "dev:gateway": "npm run dev -w @teamops/gateway",
    "dev:stack": "node ./tools/dev-stack.mjs",
    "dev:stack:seed": "node ./tools/dev-stack.mjs --seed",
    "start:web-admin": "npm run start -w @teamops/web-admin",
    "start:desktop": "npm run start -w @teamops/desktop",
    "start:control-api": "npm run start -w @teamops/control-api",
    "start:export-worker": "npm run start -w @teamops/export-worker",
    "start:gateway": "npm run start -w @teamops/gateway",
    "start:prod:admin": "node ./tools/prod-admin-stack.mjs",
    "start:prod:web-admin": "npm run start:prod -w @teamops/web-admin",
    "start:prod:desktop": "npm run build:web-admin && npm run start:prod -w @teamops/desktop",
    "start:prod:control-api": "npm run start:prod -w @teamops/control-api",
    "start:prod:export-worker": "npm run start:prod -w @teamops/export-worker",
    "start:prod:gateway": "npm run start:prod -w @teamops/gateway",
    "build:prod:admin": "npm run build:config && npm run build:contracts && npm run build:database && npm run build:control-api && npm run build:gateway && npm run build:web-admin",
    "build:config": "npm run build -w @teamops/config",
    "build:contracts": "npm run build -w @teamops/contracts",
    "build:database": "npm run build -w @teamops/database",
    "build:export-jobs": "npm run build -w @teamops/export-jobs",
    "build:web-admin": "npm run build -w @teamops/web-admin",
    "build:control-api": "npm run build -w @teamops/control-api",
    "build:export-worker": "npm run build -w @teamops/export-worker",
    "build:gateway": "npm run build -w @teamops/gateway",
    "typecheck:config": "npm run typecheck -w @teamops/config",
    "typecheck:contracts": "npm run typecheck -w @teamops/contracts",
    "typecheck:database": "npm run typecheck -w @teamops/database",
    "typecheck:export-jobs": "npm run typecheck -w @teamops/export-jobs",
    "typecheck:control-api": "npm run typecheck -w @teamops/control-api",
    "typecheck:export-worker": "npm run typecheck -w @teamops/export-worker",
    "typecheck:gateway": "npm run typecheck -w @teamops/gateway",
    "typecheck:web-admin": "npm run typecheck -w @teamops/web-admin",
    "typecheck": "npm run typecheck:config && npm run typecheck:contracts && npm run typecheck:database && npm run typecheck:export-jobs && npm run typecheck:control-api && npm run typecheck:export-worker && npm run typecheck:gateway && npm run typecheck:web-admin",
    "test:control-api": "npm run test -w @teamops/control-api",
    "test:export-jobs": "npm run test -w @teamops/export-jobs",
    "test:gateway": "npm run test -w @teamops/gateway",
    "test:web-admin": "npm run test -w @teamops/web-admin",
    "test": "npm run test:control-api && npm run test:export-jobs && npm run test:gateway && npm run test:web-admin",
    "env:check": "npm run env:check:dev",
    "env:check:dev": "npm run env:check:dev -w @teamops/config",
    "env:check:prod": "npm run env:check:prod -w @teamops/config",
    "db:up": "node ./tools/dev-db.mjs up",
    "db:down": "node ./tools/dev-db.mjs down",
    "db:logs": "node ./tools/dev-db.mjs logs",
    "db:migrate": "npm run db:migrate -w @teamops/database",
    "demo:reset": "npm run demo:reset -w @teamops/database",
    "demo:seed": "npm run demo:seed -w @teamops/database && npm run demo:brief",
    "demo:brief": "node ./tools/demo-brief.mjs",
    "demo:smoke": "node ./tools/demo-smoke.mjs",
    "detect": "node --import tsx ./tools/detector/src/cli.ts",
    "verify": "node --import tsx ./tools/verification/src/cli.ts",
    "check:web-admin-i18n": "node ./tools/check-web-admin-i18n.mjs",
    "test:detector": "find ./tools/detector/src -type f -name '*.test.ts' -print0 | xargs -0 node --import tsx --test",
    "test:verification": "npm run test:detector",
    "test:watermark": "node --test ./tools/watermark/watermark.test.mjs",
    "test:attestation": "npm run test:watermark",
    "watermark:inspect": "node ./tools/watermark/inspect.mjs",
    "lineage:inspect": "node ./tools/lineage/inspect.mjs",
    "smoke:web-admin": "node ./tools/web-admin-smoke.mjs",
    "demo:up": "node ./tools/demo-stack.mjs up",
    "demo:down": "node ./tools/demo-stack.mjs down",
    "preview:build": "node ./tools/preview-stack.mjs build",
    "preview:logs": "node ./tools/preview-stack.mjs logs",
    "preview:smoke": "node ./tools/preview-smoke.mjs",
    "preview:verify": "npm run env:check:prod && npm run preview:smoke",
    "preview:up": "node ./tools/preview-stack.mjs up",
    "preview:down": "node ./tools/preview-stack.mjs down",
    "prod:secrets": "node ./tools/prod-secrets.mjs",
    "prod:preflight": "node --import tsx ./tools/prod-preflight.ts",
    "prod:inventory": "node --import tsx ./tools/prod-db-ops.ts inventory",
    "prod:revoke-virtual-keys": "node --import tsx ./tools/prod-db-ops.ts revoke-virtual-keys",
    "prod:revoke-placeholder-providers": "node --import tsx ./tools/prod-db-ops.ts revoke-placeholder-providers"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "playwright": "^1.59.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
