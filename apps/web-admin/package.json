{
  "name": "@teamops/web-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TEAMOPS_ENV=development NEXT_DIST_DIR=.next-dev node ../../tools/run-with-root-env.mjs next dev --port 3001",
    "build": "rm -rf .next* tsconfig.tsbuildinfo && TEAMOPS_ENV=production NODE_ENV=production node ../../tools/run-with-root-env.mjs env -u NEXT_DIST_DIR next build",
    "start": "TEAMOPS_ENV=development NEXT_DIST_DIR=.next-dev node ../../tools/run-with-root-env.mjs next dev --hostname 0.0.0.0 --port 3001",
    "start:demo": "TEAMOPS_ENV=development NEXT_DIST_DIR=.next-dev node ../../tools/run-with-root-env.mjs next dev --hostname 0.0.0.0 --port 3001",
    "start:prod": "TEAMOPS_ENV=production NODE_ENV=production next start --hostname 0.0.0.0 --port ${WEB_ADMIN_PORT:-3001}",
    "test": "find app -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print0 | xargs -0 node --import tsx --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query": "^5.99.0",
    "@teamops/contracts": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.7.0",
    "next": "^15.5.3",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.4.31",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/react": "19.2.14"
  },
  "engines": {
    "node": "^20.11.1 || ^22.0.0"
  }
}
