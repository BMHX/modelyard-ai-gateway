{
  "name": "@teamops/export-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TEAMOPS_ENV=development node --watch --import tsx ./src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "TEAMOPS_ENV=development node --import tsx ./src/server.ts",
    "start:prod": "TEAMOPS_ENV=production NODE_ENV=production NODE_OPTIONS=\"${NODE_OPTIONS:-} --conditions=production\" node ./dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@teamops/config": "0.1.0",
    "@teamops/database": "0.1.0",
    "@teamops/export-jobs": "0.1.0"
  }
}
