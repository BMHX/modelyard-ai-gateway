# Shared
NODE_ENV=development

# Optional when control-api and export-worker run on different filesystems.
# EXPORT_JOBS_DIR=/var/lib/teamops/exports

# Control API
CONTROL_API_PORT=4001
CONTROL_API_HOST=0.0.0.0
DATABASE_URL=postgres://teamops:teamops@127.0.0.1:5432/teamops
VALKEY_URL=redis://127.0.0.1:6379
CONTROL_API_ADMIN_TOKEN=demo-admin-token

# Gateway
GATEWAY_PORT=4002
GATEWAY_HOST=0.0.0.0
GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:4002
DEMO_MODE=1

# Web Admin
CONTROL_API_BASE_URL=http://127.0.0.1:4001
NEXT_PUBLIC_CONTROL_API_BASE_URL=http://127.0.0.1:4001
# Public external URL used for OIDC redirect_uri, CORS, and browser redirects.
# WEB_ADMIN_BASE_URL=https://admin.example.com
# Use session only when you are explicitly testing the control-plane OIDC flow locally.
WEB_ADMIN_AUTH_MODE=bootstrap_admin

# Web Site
# NEXT_PUBLIC_SITE_DEMO_URL=https://calendar.example.com/teamops
# NEXT_PUBLIC_SITE_DOCS_BASE_URL=https://github.com/example/teamops/blob/main/

# Security
ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
FINGERPRINT_KEY_ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PRIVATE_RESPONSE_ATTESTATION_SECRET=teamops-dev-private-attestation-secret
PRIVATE_RESPONSE_ATTESTATION_KEY_ID=attk1
# Optional per-service override.
# PRIVATE_RESPONSE_ATTESTATION_INSTANCE_ID=dev-runtime-1

# Official release lineage context. Provide these for signed official delivery builds.
# TEAMOPS_LINEAGE_PROFILE=official:customer:deployment:release
# TEAMOPS_LINEAGE_CUSTOMER=cus_demo
# TEAMOPS_LINEAGE_DEPLOYMENT=dep_demo
# TEAMOPS_LINEAGE_RELEASE=rel_demo
# TEAMOPS_LINEAGE_SECRET=replace-with-a-long-random-secret
# TEAMOPS_LINEAGE_CHANNEL=self-host
# TEAMOPS_LINEAGE_REQUIRED=1
